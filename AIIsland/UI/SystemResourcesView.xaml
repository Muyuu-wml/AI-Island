<UserControl x:Class="AIIsland.UI.SystemResourcesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AIIsland.UI" Foreground="#EDF0F7">
 <UserControl.Resources>
  <Style x:Key="UsageBar" TargetType="ProgressBar">
   <Setter Property="Height" Value="8"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
   <Setter Property="Background" Value="#374254"/><Setter Property="Foreground" Value="#72D8EE"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="4"/>
     <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Expander Header="系统资源" Foreground="#EDF0F7" IsExpanded="{Binding IsExpanded}" HorizontalContentAlignment="Stretch">
  <StackPanel Margin="0,14,0,0">
   <Grid Margin="0,0,0,7"><TextBlock Text="CPU" FontSize="12"/><TextBlock Text="{Binding CpuLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
   <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding CpuPercent, Mode=OneWay}" IsEnabled="{Binding HasCpu}" AutomationProperties.Name="CPU 使用率"/>
   <Grid Margin="0,14,0,7"><TextBlock Text="内存" FontSize="12"/><TextBlock Text="{Binding MemoryLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
   <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding MemoryPercent, Mode=OneWay}" IsEnabled="{Binding HasMemory}" Foreground="#A8ACF1" AutomationProperties.Name="内存使用率"/>
   <TextBlock Text="{Binding MemoryUsage}" Foreground="#9CA8BA" FontSize="11" Margin="0,6,0,0"/>
   <Border Height="1" Background="#37404E" Margin="0,16,0,13"/>
   <Grid Margin="0,0,0,10"><TextBlock Text="磁盘空间" FontSize="12"/><TextBlock Text="圆环表示已用" HorizontalAlignment="Right" Foreground="#9CA8BA" FontSize="10" VerticalAlignment="Center"/></Grid>
   <ItemsControl ItemsSource="{Binding Disks}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Margin="0,0,6,8" Padding="8,10" Background="#2B303B" CornerRadius="10">
      <StackPanel HorizontalAlignment="Center">
       <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
       <Grid Width="66" Height="66" HorizontalAlignment="Center">
        <ui:UsageRing Value="{Binding UsedPercent, Mode=OneWay}"/>
        <TextBlock Text="{Binding PercentLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
       </Grid>
       <TextBlock Text="{Binding CapacityLabel}" Foreground="#AFB9C9" TextAlignment="Center" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{Binding DiskStatus}" Foreground="#9CA8BA" FontSize="11" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Note}" Foreground="#E8BD78" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
 </Expander>
</UserControl>
